# Application
APP_NAME="Multilingual Voice-First Revenue Services Platform"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database — change credentials before any shared deployment
DATABASE_URL=postgresql+psycopg2://revenue:revenue@localhost:5432/revenue_poc
POSTGRES_USER=revenue
POSTGRES_PASSWORD=revenue
POSTGRES_DB=revenue_poc

# Provider mode: local (default) | cloud (gated by Data Boundary Gateway)
PROVIDER_MODE=local
CLOUD_AI_ENABLED=false

# Local STT (faster-whisper) — model size drives multilingual accuracy.
# tiny  : fast, ~English-only in practice
# small : recommended floor for usable Hindi/Kannada recognition on CPU
# medium: noticeably better accuracy, slower, needs more RAM
WHISPER_MODEL_SIZE=small
WHISPER_BEAM_SIZE=5

# Local TTS — Piper neural voices (en/hi) with eSpeak NG fallback (incl. Kannada).
# Kannada has no official Piper voice; full Indic/MMS neural TTS is not baked
# (would pull PyTorch). kn stays on eSpeak unless you add a local model later.
PIPER_BIN=piper
TTS_VOICES_DIR=data/tts
PIPER_EN_VOICE=en_US-lessac-medium.onnx
PIPER_HI_VOICE=hi_IN-priyamvada-medium.onnx

# Boundary policy path (relative to repo root)
BOUNDARY_POLICY_PATH=config/boundary/policies.yaml

# Local restricted document storage (never cloud)
DOCUMENT_STORAGE_PATH=data/documents

# Officer dashboard POC token (header X-Officer-Token)
OFFICER_API_TOKEN=officer-poc-token

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Optional cloud AI — unused for restricted data. Leave empty.
# OPENAI_API_KEY=
